# ---- Public URL (HTTPS, must be reachable by Telegram) ----
DOMAIN=geasy.example.com
PUBLIC_BASE_URL=https://geasy.example.com

# ---- Postgres ----
POSTGRES_USER=geasy
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=geasy
DATABASE_URL=postgres://geasy:change-me-long-random@postgres:5432/geasy

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Secrets (generate: openssl rand -hex 32) ----
# Encrypts bot token / MTProto session at rest. Losing it means re-entering credentials.
ENCRYPTION_KEY=
# Optional: Telegram Bot API base (leave default in production)
# TELEGRAM_API_BASE=https://api.telegram.org

# ---- First admin (used by `npm run user:create` / the compose "bootstrap" service) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---- Worker ----
WORKER_PORT=4000
LOG_LEVEL=info
