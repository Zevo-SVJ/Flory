# ---------------------------------------------------------------------------
# Worth — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to expose to the browser — Row Level
# Security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment. Used for OAuth redirects, canonical URLs,
# sitemap and Open Graph image URLs. No trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: Worth deliberately does NOT use a Supabase service-role key. Nothing in
# the app needs to bypass Row Level Security. Do not add one.
